# Copy this file to .env. Never commit .env; share real secrets only through
# a team password manager (not Git, chat, issues or pull requests).
#
# Public Supabase client settings (never use a service_role key in the browser).
# The project URL is public. Fill the anon/publishable key from
# Supabase -> Settings -> API Keys (or the team's password manager).
VITE_SUPABASE_URL=https://pscjbvjcprvzfkawflql.supabase.co
VITE_SUPABASE_ANON_KEY=
# Public bucket name used for signed attachment links in the course editor.
VITE_SUPABASE_ATTACHMENTS_BUCKET=course-attachments
# URL of the deployed ASP.NET API. Local default: http://localhost:4174.
# Change to the public API URL when deploying the frontend.
VITE_API_URL=http://localhost:4174

# Backend verification of Supabase Auth tokens (the publishable key is public).
SUPABASE_URL=https://pscjbvjcprvzfkawflql.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Auth mode: leave empty/supabase for the full Supabase app. Set legacy only
# for legacy JWT tests with a dedicated PostgreSQL database.
AUTH_MODE=supabase

# ASP.NET Core backend (server/Linea.Api). Never commit real values.
# JWT_KEY must be at least 32 bytes; generate it with a password manager or
# the PowerShell command in server/README.md.
JWT_KEY=
JWT_ISSUER=linea-api
JWT_AUDIENCE=linea-client
JWT_EXPIRY_MINUTES=60
# Required server-only PostgreSQL URL. Get it from the team's password manager.
# URL-encode special characters in the password. Never prefix with VITE_.
# Session pooler (IPv4): postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
# Direct connection: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=
# Apply EF migrations only when explicitly enabled, including local development.
RUN_MIGRATIONS=false
# Comma-separated list of allowed browser origins (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Server-only settings for teacher portfolio storage, signed URLs and email.
# Never prefix these with VITE_ and never commit real secrets.
# Required for Supabase Storage uploads/downloads (portfolio, assignments, media).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teacher-docs
# Private bucket for learner assignment images. The backend verifies signature,
# MIME and size and signs short-lived URLs after permission checks.
ASSIGNMENT_STORAGE_BUCKET=assignment-submissions
# Buckets used by the course editor/media API. Apply the matching storage policy.
SUPABASE_MEDIA_BUCKET=course-media
SUPABASE_ATTACHMENTS_BUCKET=course-attachments
# Generate a 32+ byte secret for stable signed URLs; if empty the app uses an
# ephemeral key and warns that URLs stop working after a restart.
SIGNED_URL_KEY=
TEACHER_DOCS_PATH=
EMAIL_OUTBOX_PATH=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true

# Demo payment only. Never switch this to a real gateway in Sprint 6-7.
PAYMENT_MODE=DEMO

# Optional first-run administrator. Remove SEED_ADMIN_PASSWORD after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
